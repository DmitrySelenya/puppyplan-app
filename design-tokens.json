{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "PuppyPlan design tokens — light mode + phone only. For the V2 warm 'Clay' palette (colour, surface, text, accent, status, stroke, pill, elevation) THIS FILE is canonical, mirroring the Miro design-freeze (docs/design/v2/reference/tokens.reference.css + README). Inline colour hexes in DESIGN.md §1.2/§1.5 predate the Clay adoption and are superseded — see the override banner at DESIGN.md §1.2. Non-colour structure (typography scale, spacing, layout, motion, haptics, component contracts) still follows DESIGN.md §1.",
  "$metadata": {
    "version": "1.1.0-v2",
    "scope": "light-mode, phone-only",
    "source": "DESIGN.md",
    "lastUpdated": "2026-07-01",
    "v2Sync": "Full Clay adoption from the Miro design-freeze (docs/design/v2/reference/tokens.reference.css + README). Surfaces→cream (base #F6EFE3 / raised #FFFCF6 / sunken #ECE3D4), text→warm espresso/taupe, primary→Clay ramp, accent→Honey (was Ember Coral), status/stroke/pill→Clay, elevation shadows→warm brown. This REVERSES the earlier §2.1 hold that kept higher-contrast surfaces; the warm cream is now canonical per user direction. `completed` pill kept as a distinct warm neutral (commit 610bf48). Sage ramp from Clay not yet added (success/success-tint carry the sage semantic); add if a screen needs the full ramp."
  },

  "color": {
    "$description": "Color tokens. Light mode only in v1. Dark fallback values exist in DESIGN.md §1.2.1 as v2 reference but are not rendered in v1.",

    "surface": {
      "base":    { "$value": "#F6EFE3", "$type": "color", "$description": "Clay cream. Основной фон экрана. Clay freeze (docs/design/v2/reference/tokens.reference.css); supersedes higher-contrast #FBFAF7 per V2 warm adoption." },
      "raised":  { "$value": "#FFFCF6", "$type": "color", "$description": "Cards, list rows — warm white, not pure #FFFFFF. Clay freeze." },
      "sunken":  { "$value": "#ECE3D4", "$type": "color", "$description": "Группированные секции, search bar. Clay freeze." },
      "overlay": { "$value": "rgba(255,252,246,0.96)", "$type": "color", "$description": "Sheets, popovers — warm-white overlay. Clay freeze." },
      "scrim":   { "$value": "rgba(40,30,22,0.34)", "$type": "color", "$description": "Modal backdrop — warm brown scrim. Clay freeze." }
    },

    "text": {
      "primary":     { "$value": "#2C2824", "$type": "color", "$description": "Warm espresso. ~11.5:1 vs surface/base. Clay freeze (softer than pure charcoal #1C1F1B)." },
      "secondary":   { "$value": "#6B6256", "$type": "color", "$description": "Warm taupe. ~5.4:1 vs surface/base. Clay freeze." },
      "tertiary":    { "$value": "#766C5A", "$type": "color", "$description": "Muted warm taupe — captions/meta. Darkened from Clay #8A7E6C to meet WCAG AA (4.5:1) on surface base+raised; #8A7E6C measured only 3.48:1." },
      "disabled":    { "$value": "#A99E8C", "$type": "color", "$description": "Decorative only — fails WCAG AA for body text. Clay freeze." },
      "on-primary":  { "$value": "#FFF7EF", "$type": "color", "$description": "Warm white on primary/600. Clay freeze." },
      "on-accent":   { "$value": "#2C2824", "$type": "color", "$description": "Espresso on accent/honey. Clay freeze." },
      "link":        { "$value": "#B26A3C", "$type": "color", "$description": "Clay link = primary/600. Clay freeze." }
    },

    "primary": {
      "$description": "Clay ramp. Brand, focus, primary actions. Clay freeze (docs/design/v2/reference/tokens.reference.css) — softer, warmer than the interim terracotta scale.",
      "50":  { "$value": "#FBF2EA", "$type": "color", "$description": "Tinted backgrounds, selected rows" },
      "100": { "$value": "#F4DCC6", "$type": "color", "$description": "Hover/pressed tint" },
      "200": { "$value": "#ECC09C", "$type": "color", "$description": "Disabled fill / illustrative wash" },
      "300": { "$value": "#E0A271", "$type": "color", "$description": "Warm illustration, not default CTA" },
      "400": { "$value": "#D08851", "$type": "color", "$description": "Warm mid-clay" },
      "500": { "$value": "#C77F4F", "$type": "color", "$description": "Clay — default brand, selected nav/day, focus ring" },
      "600": { "$value": "#B26A3C", "$type": "color", "$description": "Primary button fill; warm-white text" },
      "700": { "$value": "#8C5028", "$type": "color", "$description": "Pressed state / text on primary/50" },
      "800": { "$value": "#5E3318", "$type": "color", "$description": "Headings on tinted bg" },
      "900": { "$value": "#4C2117", "$type": "color", "$description": "Future dark-mode warm accent text" }
    },

    "accent": {
      "$description": "Honey — warm highlight for logged facts and CELEBRATION. Never default CTA, never urgent. Clay freeze (docs/design/v2/reference/tokens.reference.css) — supersedes the interim Ember Coral.",
      "100": { "$value": "#FBEFD9", "$type": "color", "$description": "Honey tint — fact/celebration card fill" },
      "300": { "$value": "#F2D196", "$type": "color", "$description": "Confetti, badge fill" },
      "500": { "$value": "#E3A53C", "$type": "color", "$description": "Honey — fact/celebration icon" },
      "700": { "$value": "#B07A1E", "$type": "color", "$description": "Text on accent/100" }
    },

    "sage": {
      "$description": "Sage green ramp — calm success/done affordances (Diary done-state cards, checkmarks, sage icon chips). Clay freeze (docs/design/v2/reference/tokens.reference.css).",
      "100": { "$value": "#E8EEDD", "$type": "color", "$description": "Done-card fill, sage icon-chip background" },
      "300": { "$value": "#BCD0A0", "$type": "color", "$description": "Illustrative wash" },
      "500": { "$value": "#84A06A", "$type": "color", "$description": "Checkmark fill (done)" },
      "700": { "$value": "#5E7A3E", "$type": "color", "$description": "Sage icon/text on sage/100" }
    },

    "status": {
      "$description": "Muted status colors. Danger is user-marked only. DESIGN.md §1.2.5",
      "success":      { "$value": "#5C7A45", "$type": "color", "$description": "Sage green. Clay freeze." },
      "success-tint": { "$value": "#E7EEDB", "$type": "color", "$description": "Fill only. Clay freeze." },
      "warning":      { "$value": "#A87A2A", "$type": "color", "$description": "Amber. Clay freeze." },
      "warning-tint": { "$value": "#F7EAD2", "$type": "color", "$description": "Fill only. Clay freeze." },
      "danger":       { "$value": "#A24A3C", "$type": "color", "$description": "Clay Red — USER-MARKED URGENT ONLY. NEVER bright red. Clay freeze." },
      "danger-tint":  { "$value": "#F4E4E0", "$type": "color", "$description": "Fill only. Clay freeze." },
      "info":         { "$value": "#6E5862", "$type": "color", "$description": "Warm mauve. 5.3:1 on info tint" },
      "info-tint":    { "$value": "#ECE4E6", "$type": "color", "$description": "Fill only" }
    },

    "stroke": {
      "default":           { "$value": "#E4D9C8", "$type": "color", "$description": "Card hairline, dividers — warm sand. Clay freeze." },
      "strong":            { "$value": "#C9BBA6", "$type": "color", "$description": "Warm sand, stronger. Clay freeze." },
      "divider-hairline":  { "$value": "rgba(228,217,200,0.6)", "$type": "color", "$description": "stroke/default @ 60%. Clay freeze." },
      "focus-ring":        { "$value": "#C77F4F", "$type": "color", "$description": "Clay = primary/500. 2pt outline + 2pt offset. Clay freeze." }
    },

    "pill": {
      "$description": "Health-status pill colors. Pill = fill + text + icon (shape duplicates meaning, never color alone). DESIGN.md §1.2.7",
      "template":          { "fill": { "$value": "#EFE6D7", "$type": "color" }, "text": { "$value": "#6B6256", "$type": "color" } },
      "needs-vet-review":  { "fill": { "$value": "#F7EAD2", "$type": "color" }, "text": { "$value": "#7E5A18", "$type": "color", "$description": "Clay freeze" } },
      "confirmed":         { "fill": { "$value": "#E7EEDB", "$type": "color" }, "text": { "$value": "#44602E", "$type": "color", "$description": "Clay freeze" } },
      "completed":         { "fill": { "$value": "#E8E2D7", "$type": "color" }, "text": { "$value": "#6B6256", "$type": "color", "$description": "Neutralized warm pill (commit 610bf48), text follows Clay secondary" } },
      "pending":           { "fill": { "$value": "#EFE6D7", "$type": "color" }, "text": { "$value": "#6B6256", "$type": "color" } },
      "failed":            { "fill": { "$value": "#F3E2DE", "$type": "color" }, "text": { "$value": "#7E3328", "$type": "color", "$description": "Clay freeze" } },
      "urgent":            { "fill": { "$value": "#F7EAD2", "$type": "color" }, "text": { "$value": "#7E5A18", "$type": "color", "$description": "User-marked only. Clay freeze." } }
    }
  },

  "typography": {
    "$description": "V2 typography: Lora for display/headings, Nunito for body/text, with native SF Pro/Roboto fallbacks. Redesign intake Decision 5.",
    "fontFamily": {
      "display": { "$value": "Lora", "$type": "fontFamily" },
      "text":    { "$value": "Nunito", "$type": "fontFamily" },
      "ios":     { "$value": "SF Pro Text", "$type": "fontFamily" },
      "android": { "$value": "Roboto", "$type": "fontFamily" },
      "mono":    { "$value": ["SF Mono", "Roboto Mono", "monospace"], "$type": "fontFamily" }
    },
    "fontWeight": {
      "regular":  { "$value": 400, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" }
    },
    "scale": {
      "display":     { "$value": { "fontSize": "34pt", "lineHeight": "41pt", "fontWeight": 600, "dynamicType": "largeTitle" }, "$type": "typography", "$description": "Onboarding hero, celebration" },
      "title-1":     { "$value": { "fontSize": "28pt", "lineHeight": "34pt", "fontWeight": 600, "dynamicType": "title1" },     "$type": "typography", "$description": "Screen title (Today header)" },
      "title-2":     { "$value": { "fontSize": "22pt", "lineHeight": "28pt", "fontWeight": 600, "dynamicType": "title2" },     "$type": "typography", "$description": "Section header в sheet" },
      "title-3":     { "$value": { "fontSize": "20pt", "lineHeight": "25pt", "fontWeight": 600, "dynamicType": "title3" },     "$type": "typography", "$description": "Card title" },
      "headline":    { "$value": { "fontSize": "17pt", "lineHeight": "22pt", "fontWeight": 600, "dynamicType": "headline" },   "$type": "typography", "$description": "Row primary text" },
      "body":        { "$value": { "fontSize": "17pt", "lineHeight": "24pt", "fontWeight": 400, "dynamicType": "body" },       "$type": "typography", "$description": "Основной читаемый текст" },
      "body-emph":   { "$value": { "fontSize": "17pt", "lineHeight": "24pt", "fontWeight": 600, "dynamicType": "body" },       "$type": "typography", "$description": "Inline ударение" },
      "callout":     { "$value": { "fontSize": "16pt", "lineHeight": "22pt", "fontWeight": 400, "dynamicType": "callout" },    "$type": "typography", "$description": "Описательные подписи. Минимум читаемого текста." },
      "subheadline": { "$value": { "fontSize": "15pt", "lineHeight": "20pt", "fontWeight": 400, "dynamicType": "subheadline" }, "$type": "typography", "$description": "Метаданные" },
      "footnote":    { "$value": { "fontSize": "13pt", "lineHeight": "18pt", "fontWeight": 400, "dynamicType": "footnote" },   "$type": "typography", "$description": "Timestamps, source labels" },
      "caption":     { "$value": { "fontSize": "12pt", "lineHeight": "16pt", "fontWeight": 400, "dynamicType": "caption1" },   "$type": "typography", "$description": "Pill labels, tab labels" },
      "code":        { "$value": { "fontSize": "15pt", "lineHeight": "20pt", "fontWeight": 400, "family": "mono" },            "$type": "typography", "$description": "Dosage, ID strings" }
    },
    "rules": [
      "Минимум читаемого текста — 16pt (Callout). Body = 17pt по умолчанию.",
      "Line-length 65–75 символов.",
      "Tabular numerals для всех числовых данных (weight, dose, time).",
      "Letter-spacing 0 для всех размеров.",
      "Weight Light/Thin запрещён."
    ]
  },

  "space": {
    "$description": "4pt grid. Canonical scale. DESIGN.md §1.4. Aliases s/N and s-N → see DESIGN.md Part 2 intro for mapping.",
    "0":  { "$value": "0pt",  "$type": "dimension" },
    "1":  { "$value": "4pt",  "$type": "dimension" },
    "2":  { "$value": "8pt",  "$type": "dimension" },
    "3":  { "$value": "12pt", "$type": "dimension" },
    "4":  { "$value": "16pt", "$type": "dimension" },
    "5":  { "$value": "20pt", "$type": "dimension" },
    "6":  { "$value": "24pt", "$type": "dimension" },
    "8":  { "$value": "32pt", "$type": "dimension" },
    "10": { "$value": "40pt", "$type": "dimension" },
    "14": { "$value": "56pt", "$type": "dimension" }
  },

  "layout": {
    "$description": "Layout rules. DESIGN.md §1.4",
    "screen-padding-phone":   { "$value": "16pt", "$type": "dimension", "$description": "Horizontal phone screen edge padding. DESIGN.md §1.4" },
    "screen-padding-y":       { "$value": "24pt", "$type": "dimension", "$description": "Vertical screen edge padding after safe-area handling; separate from section-gap. DESIGN.md §1.4" },
    "screen-padding-tablet":  { "$value": "24pt", "$type": "dimension", "$description": "v2 reference — tablet out-of-scope in v1" },
    "section-gap":            { "$value": "24pt", "$type": "dimension" },
    "card-padding":           { "$value": "16pt", "$type": "dimension" },
    "tap-target-min":         { "$value": "44pt", "$type": "dimension", "$description": "WCAG 2.5.5 / Apple HIG minimum" },
    "tap-target-thumb-zone":  { "$value": "56pt", "$type": "dimension", "$description": "Quick Log FAB and primary CTAs" },
    "tap-gap-min":            { "$value": "8pt",  "$type": "dimension" },
    "max-content-width":      { "$value": "560pt", "$type": "dimension", "$description": "Long-read text (vaccination details, vet notes)" },
    "tab-bar-height":         { "$value": "49pt", "$type": "dimension", "$description": "+ safe-area bottom inset" },
    "bottom-inset-fab":       { "$value": "120pt", "$type": "dimension", "$description": "Scroll bottom inset for FAB log surfaces before device safe-area addition" },
    "app-bar-collapsed":      { "$value": "44pt", "$type": "dimension", "$description": "+ safe-area top inset" },
    "app-bar-expanded":       { "$value": "96pt", "$type": "dimension", "$description": "Large-title mode" }
  },

  "radius": {
    "$description": "DESIGN.md §1.5",
    "sm":   { "$value": "8pt",   "$type": "dimension", "$description": "Buttons, inputs, pills, tracker tile inner" },
    "md":   { "$value": "12pt",  "$type": "dimension", "$description": "Cards, list groups, snackbars" },
    "lg":   { "$value": "16pt",  "$type": "dimension", "$description": "Bottom sheets, modal sheets" },
    "full": { "$value": "999pt", "$type": "dimension", "$description": "Avatars, FAB" }
  },

  "elevation": {
    "$description": "4 levels, warm-brown shadows (Clay freeze). No inner-shadow, no glow. Colour warmed from charcoal to #46321E per V2 warm adoption; geometry unchanged.",
    "0": { "$value": { "shadow": "none", "border": "1px solid #E4D9C8", "androidElevation": 0 }, "$type": "shadow", "$description": "Resting cards/rows — warm hairline only" },
    "1": { "$value": { "x": 0, "y": 2, "blur": 8,  "color": "#46321E", "opacity": 0.07, "androidElevation": 2 }, "$type": "shadow", "$description": "Interactive card hover/press — warm brown shadow" },
    "2": { "$value": { "x": 0, "y": -4, "blur": 16, "color": "#46321E", "opacity": 0.10, "androidElevation": 6 }, "$type": "shadow", "$description": "Bottom sheet (от низа) — warm brown shadow" },
    "3": { "$value": { "x": 0, "y": 8, "blur": 24, "color": "#46321E", "opacity": 0.14, "androidElevation": 12 }, "$type": "shadow", "$description": "Full-screen modal over scrim — warm brown shadow" }
  },

  "motion": {
    "$description": "DESIGN.md §1.7. Respect prefers-reduced-motion (see rules).",
    "duration": {
      "instant": { "$value": "80ms",  "$type": "duration" },
      "fast":    { "$value": "160ms", "$type": "duration" },
      "base":    { "$value": "240ms", "$type": "duration" },
      "slow":    { "$value": "360ms", "$type": "duration" }
    },
    "easing": {
      "standard":   { "$value": "cubic-bezier(0.4, 0, 0.2, 1)", "$type": "cubicBezier", "$description": "Bidirectional" },
      "decel":      { "$value": "cubic-bezier(0.0, 0, 0.2, 1)", "$type": "cubicBezier", "$description": "Entering" },
      "accel":      { "$value": "cubic-bezier(0.4, 0, 1, 1)",   "$type": "cubicBezier", "$description": "Exiting" },
      "emphasized": { "$value": "cubic-bezier(0.3, 0, 0, 1)",   "$type": "cubicBezier", "$description": "Celebration" }
    },
    "reduced-motion": {
      "transform-fallback":   "opacity 0→1, motion/fast",
      "celebration-fallback": "static badge, no particle",
      "sheet-fallback":       "cross-fade instead of slide-up",
      "disabled":             ["parallax", "large-title bounce"]
    }
  },

  "haptic": {
    "$description": "Native API: Haptics.impactAsync/notificationAsync (iOS), HapticFeedbackConstants (Android). DESIGN.md §1.8. Respects system 'Reduce haptics'.",
    "light":   { "ios": "impactLight",          "android": "KEYBOARD_TAP", "trigger": "Tap on Tracker Tile, open sheet" },
    "medium":  { "ios": "impactMedium",         "android": "LONG_PRESS",   "trigger": "Drag handle, segment switch" },
    "success": { "ios": "notificationSuccess",  "android": "CONFIRM",      "trigger": "Quick Log saved, vaccine confirmed" },
    "warning": { "ios": "notificationWarning",  "android": "REJECT",       "trigger": "Duplicate detected (60-second window)" },
    "error":   { "ios": "notificationError",    "android": "REJECT",       "trigger": "Failed save, permission denied" }
  },

  "icon": {
    "$description": "Linear icons 24×24pt, stroke 1.75pt rounded. SF Symbols (iOS) / Material Symbols Outlined (Android). DESIGN.md §1.6",
    "specs": {
      "size":         "24pt",
      "stroke":       "1.75pt",
      "caps":         "rounded",
      "ios-source":   "SF Symbols (regular weight, regular variant)",
      "android-source": "Material Symbols Outlined (size 24, weight 400, fill 0)",
      "active-state": "fill 1 (only in Tab Bar active)"
    },
    "core-mvp": [
      "nav.today", "nav.health", "nav.more",
      "action.quick_log", "action.add", "action.share", "action.edit", "action.delete", "action.search",
      "potty.outside", "potty.inside", "potty.poop",
      "feeding.bowl", "feeding.water", "sleep.moon",
      "zoomies.spark", "training.paw", "household.home",
      "person.solo", "person.cluster", "person.vet", "person.trainer",
      "med.vaccine", "med.deworming", "med.pill", "med.weight", "med.vet_visit",
      "status.template", "status.review", "status.confirmed", "status.completed", "status.urgent_flag"
    ],
    "utility": ["chevron.right", "chevron.down", "close.x", "check", "info.circle", "lock.shield"],
    "extended": [
      "ui.bell", "ui.bell.slash", "ui.wifi.slash",
      "ui.book", "ui.doc.text", "ui.stethoscope",
      "ui.phone", "ui.lock", "ui.gear",
      "ui.checkmark.seal", "ui.checkmark.circle", "ui.exclamation.circle",
      "ui.info.card", "ui.paw.filled",
      "person.crop.circle.badge.checkmark"
    ]
  },

  "component": {
    "$description": "Canonical component dimensions and contracts. Full anatomy in DESIGN.md §1.9.",
    "tracker-tile": {
      "$description": "DESIGN.md §1.9.6 — locked v1",
      "two-col":  { "width": "168pt", "height": "96pt", "$description": "Onboarding selector grid" },
      "three-col":{ "width": "110pt", "height": "96pt", "$description": "Quick Log sheet grid" },
      "min":      { "width": "88pt",  "height": "88pt" },
      "icon":     "28pt"
    },
    "fab": {
      "size":     "56pt",
      "radius":   "999pt",
      "fill":     "primary/600",
      "icon":     "28pt white",
      "elevation":"elev/2"
    },
    "tab-bar": {
      "height":   "49pt",
      "icon":     "24pt",
      "active":   "primary/700 + filled icon"
    },
    "bottom-sheet": {
      "min-height":    "460pt",
      "radius-top":   "16pt",
      "drag-handle":  { "width": "36pt", "height": "4pt" },
      "elevation":    "elev/2"
    },
    "list-item": {
      "min-height":   "56pt",
      "padding":      "12pt vertical, 16pt horizontal"
    },
    "snackbar": {
      "radius":         "12pt",
      "padding":        "12pt vertical, 16pt horizontal",
      "elevation":      "elev/1",
      "duration-default": "4s",
      "duration-with-action": "6s"
    },
    "pill": {
      "height":   "24pt",
      "padding":  "4pt vertical, 8pt horizontal",
      "radius":   "8pt",
      "icon":     "14pt"
    }
  },

  "contract": {
    "$description": "Hard contracts that override individual screen specs. v1 first draft.",
    "one-cta-per-hero":         "Exactly one primary CTA + at most one tertiary text-link in hero. Never two equal-weight filled buttons.",
    "quick-log-trackers-max":   5,
    "today-daily-cards-max":    5,
    "accidental-double-tap-window-seconds": 3,
    "duplicate-warning-window-seconds": 60,
    "celebration-color-only":   "accent/* — celebration ONLY (first log, milestone, vaccination confirmed). Never default CTA.",
    "danger-color-only":        "status/danger — user-marked urgent ONLY. Never system-flagged.",
    "no-streaks-days":          14,
    "tabs":                     ["diary", "pet", "more"],
    "quick-log-position":       "persistent central Add action opening a Quick Log / Schedule chooser, NOT a tab",
    "out-of-scope-v1":          ["dark-mode", "tablet", "landscape", "ipad"]
  }
}
