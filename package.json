{
  "name": "puppyplan-app",
  "version": "0.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:mcp": "EXPO_UNSTABLE_MCP_SERVER=1 expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "maestro:smoke:ios": "./scripts/build_and_run.sh maestro-ios",
    "maestro:smoke:android": "./scripts/build_and_run.sh maestro-android",
    "maestro:quick-log:ios": "./scripts/build_and_run.sh maestro-ios .maestro/quick-log.yaml",
    "maestro:quick-log:android": "./scripts/build_and_run.sh maestro-android .maestro/quick-log.yaml",
    "design:search": "node scripts/design/design-system.mjs search",
    "design:component": "node scripts/design/design-system.mjs component",
    "design:manifest": "node scripts/design/design-system.mjs manifest",
    "design:doctor": "node scripts/design/design-system.mjs doctor",
    "tokens:generate": "node scripts/design/generate-tokens.mjs",
    "tokens:check": "node scripts/design/generate-tokens.mjs --check",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:node && npm run test:scaffold",
    "test:unit": "jest --runInBand",
    "test:node": "node --test scripts/checks/*.test.mjs scripts/design/*.test.mjs scripts/design/lib/*.test.mjs",
    "test:scaffold": "node scripts/checks/check-navigation-contract.mjs && node scripts/checks/check-shell-i18n.mjs && node scripts/checks/check-i18n.mjs && node scripts/checks/check-scaffold-guardrails.mjs && node scripts/checks/check-plans-index.mjs && node scripts/checks/check-release-fail-closed.mjs && npm run tokens:check && node scripts/checks/privacy-scan.mjs && node scripts/checks/text-hygiene.mjs && npm run design:doctor",
    "check": "npm run lint && npm run typecheck && npm run test",
    "supabase:test": "node scripts/supabase/run-remote-cli.mjs test",
    "supabase:lint": "node scripts/supabase/run-remote-cli.mjs lint",
    "supabase:auth:otp-template": "node scripts/supabase/configure-dev-auth-email-otp.mjs",
    "supabase:auth:debug-account": "node scripts/supabase/upsert-dev-debug-account.mjs",
    "supabase:guardrails": "node --test scripts/checks/supabase-baseline.test.mjs scripts/checks/supabase-typegen-output.test.mjs && node scripts/checks/check-database-types-generated.mjs",
    "db:types": "node scripts/supabase/run-remote-cli.mjs types",
    "db:push:remote:dry-run": "node scripts/supabase/run-remote-cli.mjs push-dry-run",
    "supabase:verify:remote": "npm run db:push:remote:dry-run && npm run supabase:lint",
    "supabase:ci:remote": "npm run supabase:verify:remote && npm run db:types && npm run supabase:guardrails"
  },
  "dependencies": {
    "@expo-google-fonts/lora": "^0.4.2",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/elements": "^2.9.10",
    "@react-navigation/native": "^7.1.33",
    "@supabase/supabase-js": "^2.106.1",
    "@tanstack/react-query": "^5.100.14",
    "expo": "~55.0.28",
    "expo-asset": "~55.0.18",
    "expo-clipboard": "~55.0.14",
    "expo-constants": "~55.0.17",
    "expo-dev-client": "~55.0.37",
    "expo-font": "~55.0.8",
    "expo-linking": "~55.0.16",
    "expo-localization": "~55.0.17",
    "expo-notifications": "~55.0.25",
    "expo-router": "~55.0.17",
    "expo-secure-store": "~55.0.16",
    "expo-splash-screen": "~55.0.23",
    "expo-sqlite": "~55.0.18",
    "expo-status-bar": "~55.0.6",
    "i18next": "^25.7.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^16.5.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~55.0.1",
    "expo-doctor": "1.20.1",
    "expo-mcp": "0.2.4",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.20",
    "react-test-renderer": "19.2.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "js-yaml": "^4.3.0",
    "shell-quote": "^1.9.0",
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
