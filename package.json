{
  "name": "puppyplan-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "tokens:generate": "node scripts/design/generate-tokens.mjs",
    "tokens:check": "node scripts/design/generate-tokens.mjs --check",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:node && npm run test:scaffold",
    "test:unit": "jest --runInBand",
    "test:node": "node --test scripts/checks/*.test.mjs scripts/design/*.test.mjs scripts/design/lib/*.test.mjs",
    "test:scaffold": "node scripts/checks/check-navigation-contract.mjs && node scripts/checks/check-shell-i18n.mjs && node scripts/checks/check-i18n.mjs && node scripts/checks/check-scaffold-guardrails.mjs && npm run tokens:check && node scripts/checks/privacy-scan.mjs && node scripts/checks/text-hygiene.mjs",
    "check": "npm run lint && npm run typecheck && npm run test",
    "supabase:test": "node scripts/supabase/run-remote-cli.mjs test",
    "supabase:test:remote": "node scripts/supabase/run-remote-cli.mjs test",
    "supabase:lint": "node scripts/supabase/run-remote-cli.mjs lint",
    "supabase:lint:remote": "node scripts/supabase/run-remote-cli.mjs lint",
    "db:types": "node scripts/supabase/run-remote-cli.mjs types",
    "db:types:remote": "node scripts/supabase/run-remote-cli.mjs types",
    "db:push:remote:dry-run": "node scripts/supabase/run-remote-cli.mjs push-dry-run",
    "supabase:verify:remote": "npm run db:push:remote:dry-run && npm run supabase:lint:remote",
    "supabase:ci:remote": "npm run supabase:verify:remote && npm run supabase:test:remote && npm run db:types:remote && node scripts/checks/check-database-types-generated.mjs"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/elements": "^2.9.10",
    "@react-navigation/native": "^7.1.33",
    "@supabase/supabase-js": "^2.106.1",
    "expo": "~55.0.26",
    "expo-constants": "~55.0.16",
    "expo-linking": "~55.0.15",
    "expo-router": "~55.0.16",
    "expo-splash-screen": "~55.0.21",
    "expo-sqlite": "~55.0.16",
    "expo-status-bar": "~55.0.6",
    "i18next": "^25.7.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^16.5.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~55.0.1",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.18",
    "react-test-renderer": "19.2.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
