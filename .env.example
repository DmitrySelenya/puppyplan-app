EXPO_PUBLIC_SUPABASE_URL=https://olymqppxsadsxfrcyskh.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional local dev-only password sign-in for a synthetic non-production
# account. These EXPO_PUBLIC values are bundled into dev JS when set, so never
# use a real user, real mailbox password, production account, or shared secret.
EXPO_PUBLIC_PUPPYPLAN_DEBUG_AUTH_EMAIL=
EXPO_PUBLIC_PUPPYPLAN_DEBUG_AUTH_PASSWORD=

# Project ref is safe to keep in local env files. It lets Supabase CLI typegen
# use the hosted dev project without Docker after `npx supabase login` or when
# SUPABASE_ACCESS_TOKEN is present in CI.
SUPABASE_PROJECT_REF=olymqppxsadsxfrcyskh
SUPABASE_ACCESS_TOKEN=

# Optional local-only key for scripts/supabase/upsert-dev-debug-account.mjs.
# Never expose this through EXPO_PUBLIC_* and never use it in client code.
PUPPYPLAN_DEV_SUPABASE_AUTH_ADMIN_KEY=

# Local-only Postgres connection string for Supabase CLI remote pgTAP, lint,
# and migration dry-run checks. Never expose this through EXPO_PUBLIC_* variables
# and never commit a real value.
SUPABASE_DB_URL=

# Only Docker-capable CI/cloud runners should set this to 1.
SUPABASE_CLI_DOCKER_ALLOWED=
